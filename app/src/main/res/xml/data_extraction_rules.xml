<?xml version="1.0" encoding="utf-8"?>
<!-- 학습 기록은 이 차량에만 둔다: 클라우드 백업·기기 간 이전 대상에서 모두 제외한다. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
